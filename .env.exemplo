# Copie para .env e preencha. O .env NÃO é versionado.
DATABRICKS_CONFIG_PROFILE=fe-bar
FE_BAR_WAREHOUSE_ID=<id do SQL Warehouse serverless>
# Catálogo do Unity Catalog (padrão: sinistros_clima). No FEVM, use o catálogo criado com o workspace.
FE_BAR_CATALOGO=sinistros_clima
# Prefixo opcional dos schemas (ex.: dev_ gera dev_landing, dev_bronze...). Vazio = sem prefixo.
FE_BAR_PREFIXO_SCHEMA=
# Id do job do evento (opcional, para o custo por unidade em scripts/custo_por_unidade.py)
FE_BAR_JOB_EVENTO_ID=
